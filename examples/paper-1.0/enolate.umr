UMR 1.0 INITIAL s0;

STATE s0 {"primary_view_id":"vC","total_charge":-1,"multiplicity":1};

VIEW vC {
  "state_id":"s0",
  "atoms":[
    {"atom_id":1,"element":"C","formal_charge":-1,"nonbonding_electrons":2,"hydrogens":2},
    {"atom_id":2,"element":"C","formal_charge":0,"nonbonding_electrons":0,"hydrogens":1},
    {"atom_id":3,"element":"O","formal_charge":0,"nonbonding_electrons":4}
  ],
  "bonds":[
    {"a":1,"b":2,"order":1},
    {"a":2,"b":3,"order":2}
  ]
};

VIEW vO {
  "state_id":"s0",
  "atoms":[
    {"atom_id":1,"element":"C","formal_charge":0,"nonbonding_electrons":0,"hydrogens":2},
    {"atom_id":2,"element":"C","formal_charge":0,"nonbonding_electrons":0,"hydrogens":1},
    {"atom_id":3,"element":"O","formal_charge":-1,"nonbonding_electrons":6}
  ],
  "bonds":[
    {"a":1,"b":2,"order":2},
    {"a":2,"b":3,"order":1}
  ]
};

RESONANCE enolate_C_to_O {"state_id":"s0","source_view_id":"vC","target_view_id":"vO","rule":"lone_pair_pi","rule_version":"umr-resonance/0.1"} DO {
  PAIR(1,2);
  SPLIT(2,3->3);
};
